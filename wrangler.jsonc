// Tells Cloudflare how to serve the site: upload the built pages in dist/ as
// plain files. No server code runs; it's a static site.
{
  "$schema": "https://unpkg.com/wrangler@4.151.1/config-schema.json",
  "name": "sambarlien-com",
  "compatibility_date": "2026-10-12",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
