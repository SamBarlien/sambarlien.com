---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Item from "../components/Item.astro";
import { newestFirst, kindLabel, roleLabel, withLabel } from "../lib";

const research = (await getCollection("research")).sort(newestFirst);
const writing = (await getCollection("writing")).sort(newestFirst);
const stage = (await getCollection("stage")).sort(newestFirst);
const conversations = (await getCollection("conversations")).sort(newestFirst);
const press = (await getCollection("press")).filter((p) => p.data.show).sort(newestFirst);
---
<Base title="Library · Sam Barlien" description="Everything Sam Barlien has published or presented on platform engineering: research reports, articles, talks, panels, podcasts and webinars, with links to each.">
  <h1>Library</h1>
  <p>Everything I've written or presented on platform engineering, with a link to each one.</p>

  <h2 id="research">Research · {research.length}</h2>
  <ul class="list">
    {research.map((r) => <Item title={r.data.title} url={r.data.url} take={r.data.take} details={["Report", withLabel(r.data.with)]} />)}
  </ul>

  <h2 id="stage">On stage · {stage.length}</h2>
  <ul class="list">
    {stage.map((s) => <Item title={s.data.title} url={s.data.url} details={[kindLabel(s.data.kind), roleLabel(s.data.role), s.data.where]} />)}
  </ul>

  <h2 id="conversations">In conversation · {conversations.length}</h2>
  <ul class="list">
    {conversations.map((c) => <Item title={c.data.title} url={c.data.url} details={[kindLabel(c.data.kind), roleLabel(c.data.role), c.data.where]} />)}
  </ul>

  <h2 id="writing">Writing · {writing.length}</h2>
  <ul class="list">
    {writing.map((w) => <Item title={w.data.title} url={w.data.url} details={["Article", "platformengineering.org", withLabel(w.data.with)]} />)}
  </ul>

  <h2 id="press">In the press · {press.length}</h2>
  <ul class="list">
    {press.map((p) => <Item title={p.data.title} url={p.data.url} details={[p.data.publisher, p.data.author]} />)}
  </ul>
</Base>
<style>
  .list { list-style: none; margin: 0; padding: 0; }
</style>
