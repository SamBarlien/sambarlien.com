---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Report from "../components/Report.astro";
import Row from "../components/Row.astro";
import { newestFirst, kindLabel, roleLabel } from "../lib";

const research = (await getCollection("research")).sort(newestFirst);
const writing = (await getCollection("writing")).sort(newestFirst);
const stage = (await getCollection("stage")).sort(newestFirst);
const conversations = (await getCollection("conversations")).sort(newestFirst);
const press = (await getCollection("press")).filter((p) => p.data.show).sort(newestFirst);
---
<Base title="Library · Sam Barlien" description="Everything Sam Barlien has published or presented on platform engineering: research reports, articles, talks, panels, podcasts and webinars, with links to each.">
  <h1>Library</h1>
  <p class="lede">Everything I've written or presented on platform engineering, with a link to each.</p>
  <nav class="jump">
    <a href="#research">Research</a><a href="#stage">On stage</a><a href="#conversations">In conversation</a><a href="#writing">Writing</a><a href="#press">In the press</a>
  </nav>

  <h2 id="research">Research <small>{research.length}</small></h2>
  {research.map((r, i) => <Report n={i + 1} title={r.data.title} url={r.data.url} take={r.data.take} with={r.data.with} />)}

  <h2 id="stage">On stage <small>{stage.length}</small></h2>
  {stage.map((s) => <Row label={kindLabel(s.data.kind)} title={s.data.title} url={s.data.url} detail={`${roleLabel(s.data.role)}, ${s.data.where}`} />)}

  <h2 id="conversations">In conversation <small>{conversations.length}</small></h2>
  {conversations.map((c) => <Row label={kindLabel(c.data.kind)} title={c.data.title} url={c.data.url} detail={`${roleLabel(c.data.role)}, ${c.data.where}`} />)}

  <h2 id="writing">Writing <small>{writing.length}</small></h2>
  {writing.map((w) => <Row label="Article" title={w.data.title} url={w.data.url} detail="platformengineering.org" />)}

  <h2 id="press">In the press <small>{press.length}</small></h2>
  {press.map((p) => <Row label="Press" title={p.data.title} url={p.data.url} detail={[p.data.publisher, p.data.author].filter(Boolean).join(", ")} />)}
</Base>
<style>
  .jump { display: flex; flex-wrap: wrap; gap: 8px 20px; font-size: 15px; padding-bottom: 8px; }
</style>
