---
// Shared page frame: head tags, top bar, footer. Every page uses this.
// Fonts are served from this site, not Google Fonts, so visitors' browsers
// don't contact a third party just to draw text.
import "@fontsource/instrument-serif/400.css";
import "@fontsource/instrument-serif/400-italic.css";
import "@fontsource-variable/inter";
import { siGithub, siX } from "simple-icons";

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const nav = [
  { href: "/library/", label: "Library" },
  { href: "/why/", label: "Why...?" },
];
const here = Astro.url.pathname;
const pageUrl = new URL(here, Astro.site);
const shareImage = new URL("/og-sam-barlien-v2.jpg", Astro.site);

// Hidden facts for search engines and AI tools: who Sam is, his photo, and
// which profiles elsewhere are also him.
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Sam Barlien",
  url: "https://sambarlien.com/",
  image: "https://sambarlien.com/sam-barlien.jpg",
  jobTitle: "Head of Ecosystem",
  worksFor: { "@type": "Organization", name: "Platform Engineering", url: "https://platformengineering.org" },
  knowsAbout: ["Platform engineering", "Internal developer platforms", "Agentic engineering platforms"],
  sameAs: [
    "https://platformengineering.org/authors/sam-barlien",
    "https://github.com/SamBarlien",
    "https://www.imdb.com/name/nm9463674/",
    "https://www.linkedin.com/in/sam-barlien-3b2579184/",
    "https://x.com/SamBarlien",
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- The preview card when a link is shared on LinkedIn, Slack, X etc. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Sam Barlien" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Sam Barlien" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <style is:global>
      :root {
        --paper: #f3efe6; --ink: #17150f; --muted: #6b6352; --rule: #c9c1ad; --accent: #b4401b;
        --serif: "Instrument Serif", Georgia, serif;
        --sans: "Inter Variable", -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
      }
      @media (prefers-color-scheme: dark) {
        :root { --paper: #16140f; --ink: #ece6d8; --muted: #a59b86; --rule: #3a352a; --accent: #e07a52; }
      }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--paper); color: var(--ink); font: 17px/1.6 var(--sans); -webkit-font-smoothing: antialiased; }
      a { color: inherit; text-decoration-thickness: 1px; text-underline-offset: 3px; }
      a:hover { color: var(--accent); }
      .wrap { max-width: 1040px; margin: 0 auto; padding: 0 24px; }
      @media (max-width: 520px) { .wrap { padding: 0 16px; } }
      header.bar .wrap { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding-block: 26px 14px; font-size: 14px; }
      header.bar .line { flex: 1; border-bottom: 1px solid var(--ink); }
      header.bar .wrap:last-child { padding-block: 0; }
      header.bar .name { text-decoration: none; font-weight: 500; }
      header.bar nav { display: flex; gap: 22px; }
      header.bar nav a { text-decoration: none; }
      header.bar nav a[aria-current="page"] { text-decoration: underline; }
      main { padding-block: 0 96px; }
      h1, h2 { font-family: var(--serif); font-weight: 400; letter-spacing: -0.01em; }
      h1 { font-size: clamp(52px, 8vw, 88px); line-height: 0.95; margin: 56px 0 24px; }
      h2 { font-size: 40px; line-height: 1; margin: 64px 0 0; padding-bottom: 12px; border-bottom: 1px solid var(--rule); display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
      h2 small { font: 14px var(--sans); color: var(--muted); letter-spacing: 0; }
      .lede { font: italic 400 clamp(22px, 3vw, 28px)/1.25 var(--serif); margin: 0 0 16px; }
      .muted { color: var(--muted); }
      footer .wrap { border-top: 1px solid var(--ink); padding-block: 22px 40px; display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; align-items: center; font-size: 14px; color: var(--muted); }
      .social { display: flex; gap: 18px; }
      .social a { color: var(--muted); display: block; line-height: 0; }
      .social a:hover, .social a:focus-visible { color: var(--accent); }
      .social svg { width: 20px; height: 20px; fill: currentColor; }
      .social .cut { fill: var(--paper); }
    </style>
  </head>
  <body>
    <header class="bar">
      <div class="wrap">
        <a class="name" href="/">Sam Barlien</a>
        <nav>
          {nav.map((n) => (
            <a href={n.href} aria-current={here.startsWith(n.href) ? "page" : undefined}>{n.label}</a>
          ))}
        </nav>
      </div>
      <div class="wrap"><div class="line"></div></div>
    </header>
    <main class="wrap"><slot /></main>
    <footer>
      <div class="wrap">
        <span>Sam Barlien</span>
        <span class="social">
          <a href="https://github.com/SamBarlien" aria-label="GitHub" title="GitHub">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d={siGithub.path} /></svg>
          </a>
          <a href="https://www.linkedin.com/in/sam-barlien-3b2579184/" aria-label="LinkedIn" title="LinkedIn">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <rect x="1" y="1" width="22" height="22" rx="3" />
              <g class="cut">
                <circle cx="6.9" cy="6.9" r="1.7" />
                <rect x="5.4" y="9.6" width="3" height="9" />
                <path d="M10.5 9.6h2.9v1.3c.5-.9 1.6-1.6 3-1.6 2.6 0 3.2 1.6 3.2 3.9v5h-3v-4.4c0-1.1-.2-2.1-1.4-2.1-1.3 0-1.7.9-1.7 2.1v4.4h-3z" />
              </g>
            </svg>
          </a>
          <a href="https://x.com/SamBarlien" aria-label="X (Twitter)" title="X (Twitter)">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d={siX.path} /></svg>
          </a>
        </span>
      </div>
    </footer>
  </body>
</html>
