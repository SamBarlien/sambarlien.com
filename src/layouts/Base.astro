---
// Shared page frame: head tags, top bar, footer. Every page uses this.
interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const nav = [
  { href: "/library/", label: "Library" },
  { href: "/about/", label: "About" },
  { href: "/why/", label: "Why" },
];
const here = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(here, Astro.site)} />
    <style is:global>
      :root {
        --bg: #fbfbf9; --fg: #1b1c1e; --muted: #5d6067; --line: #e3e3de; --link: #1f5fa8;
        --font: "Iowan Old Style", "Charter", Georgia, serif;
        --ui: -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
      }
      @media (prefers-color-scheme: dark) {
        :root { --bg: #141517; --fg: #e8e8e6; --muted: #a0a3a9; --line: #2c2e32; --link: #8bb8ec; }
      }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--bg); color: var(--fg); font: 18px/1.6 var(--font); }
      a { color: var(--link); text-underline-offset: 3px; }
      .wrap { max-width: 720px; margin: 0 auto; padding: 0 16px; }
      header.top { border-bottom: 1px solid var(--line); font-family: var(--ui); font-size: 15px; }
      header.top .wrap { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding-block: 18px; flex-wrap: wrap; }
      header.top .name { font-weight: 600; color: var(--fg); text-decoration: none; }
      header.top nav { display: flex; gap: 20px; }
      header.top nav a { color: var(--muted); text-decoration: none; }
      header.top nav a[aria-current="page"] { color: var(--fg); }
      main { padding-block: 40px 64px; }
      h1, h2, h3 { line-height: 1.25; }
      h2 { font-family: var(--ui); font-size: 14px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); margin: 48px 0 12px; }
      .meta { font-family: var(--ui); font-size: 14px; color: var(--muted); }
      footer { border-top: 1px solid var(--line); font-family: var(--ui); font-size: 14px; color: var(--muted); }
      footer .wrap { padding-block: 24px; }
    </style>
  </head>
  <body>
    <header class="top">
      <div class="wrap">
        <a class="name" href="/">Sam Barlien</a>
        <nav>
          {nav.map((n) => (
            <a href={n.href} aria-current={here.startsWith(n.href) ? "page" : undefined}>{n.label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main class="wrap"><slot /></main>
    <footer><div class="wrap">Sam Barlien</div></footer>
  </body>
</html>
