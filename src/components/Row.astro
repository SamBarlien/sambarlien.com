---
// One line in a ruled list: small label, linked title, and where/role.
interface Props { label: string; title: string; url: string; detail?: string }
const { label, title, url, detail } = Astro.props;
---
<div class="row">
  <span class="label">{label}</span>
  <a href={url}>{title}</a>
  {detail && <span class="detail">{detail}</span>}
</div>
<style>
  .row { display: grid; grid-template-columns: 120px minmax(0, 1.4fr) minmax(0, 1fr); gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--rule); align-items: baseline; }
  .label { font-size: 12px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); }
  .detail { font-size: 15px; color: var(--muted); }
  @media (max-width: 760px) { .row { grid-template-columns: 1fr; gap: 2px; } }
</style>
